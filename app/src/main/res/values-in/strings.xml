    <string name="mode_hybrid_title">Hibrida Otomatis (AI Online + Cadangan Offline)</string>
    <string name="mode_hybrid_pros">Terjemahan AI alami saat online; otomatis beralih ke ML Kit offline saat jaringan terputus.</string>
    <string name="mode_hybrid_cons">Teks dikirim ke server AI saat online; cadangan offline butuh unduhan paket ~30 MB.</string>
    <string name="mode_offline_title">Sepenuhnya Offline (Google ML Kit)</string>
    <string name="mode_offline_pros">Privasi maksimal di perangkat, berjalan tanpa Internet, respons sangat cepat.</string>
    <string name="mode_offline_cons">Perlu mengunduh ~30 MB per bahasa; kalimat panjang sedikit lebih kaku dibanding LLM.</string>
    <string name="mode_online_title">Khusus AI Online (Kilo Gateway / BYOK)</string>
    <string name="mode_online_pros">Kualitas paling alami untuk kalimat panjang; tidak memakan penyimpanan lokal.</string>
    <string name="mode_online_cons">Wajib terhubung Internet dan bergantung pada batas kuota gratis.</string>
