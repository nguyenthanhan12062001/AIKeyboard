    <string name="mode_hybrid_title">Auto Hybrid (Online AI + Offline Fallback)</string>
    <string name="mode_hybrid_pros">Natural context-aware AI translation when online; automatically falls back to ML Kit offline when disconnected or rate-limited.</string>
    <string name="mode_hybrid_cons">Sends text to cloud AI while online; offline fallback requires ~30 MB language packs pre-downloaded.</string>
    <string name="mode_offline_title">Pure Offline (Google ML Kit On-Device)</string>
    <string name="mode_offline_pros">Maximum privacy (zero text leaves your device), works completely without Internet, instant low-latency response.</string>
    <string name="mode_offline_cons">Requires ~30 MB download per language; long sentences sound slightly less natural than cloud LLMs.</string>
    <string name="mode_online_title">Online AI Only (Kilo Gateway / BYOK)</string>
    <string name="mode_online_pros">Highest fluency for idioms, tone, and long paragraphs; zero local model storage required.</string>
    <string name="mode_online_cons">Requires active Internet connection and may fail if network drops or free quota limits trigger.</string>
