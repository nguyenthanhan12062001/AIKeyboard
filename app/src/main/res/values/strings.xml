    <string name="about_app_name_label">Application</string>
    <string name="about_version_full">Version %1$s (Build %2$d)</string>
    <string name="about_keyboard_desc">A modern multilingual Android keyboard combining fast native Canvas key rendering with offline typing engines and built-in keyless AI translation.</string>
    <string name="about_feature_offline">100% offline typing engines: Vietnamese (Telex / VNI), Chinese Pinyin, Korean 2-Beolsik Hangul, Japanese Romaji, Indonesian, English, French, German, Spanish, Russian &amp; Thai.</string>
    <string name="about_feature_ai">Built-in free AI Translation (Kilo AI Gateway) with live translation as you type, typo-tolerant inference, and zero API key required.</string>
    <string name="about_feature_ux">Gboard-inspired UX: customizable themes, resizable layout, movable floating keyboard, emoji picker, and local clipboard pinning.</string>
    <string name="about_developer_title">Developer</string>
    <string name="about_author_name">ngthan120601</string>
    <string name="about_author_role">Independent Android Developer • Creator &amp; Maintainer of AI Keyboard</string>
    <string name="about_privacy_title">Privacy Policy</string>
    <string name="about_privacy_summary">Offline typing &amp; local clipboard; AI Translate sends only requested text</string>
    <string name="about_privacy_body">• All typing engines (Telex/VNI, Pinyin, Hangul, Romaji) and word suggestions run 100% locally offline.\n• Regular typing is never sent online. Text is only transmitted when you actively use AI Translate or enable Live Translate.\n• No keystrokes or personal text are logged or stored on external servers.\n• Clipboard history stays strictly local on your device and filters sensitive content.</string>
    <string name="about_terms_title">Terms of Use</string>
    <string name="about_terms_summary">Free personal usage &amp; third-party AI translation terms</string>
    <string name="about_terms_body">• AI Keyboard is provided free of charge for personal and productivity use.\n• Offline keyboard features require no account or internet connection.\n• AI Translation uses third-party free services (Kilo AI Gateway) subject to availability and fair-use rate limits; automated translations may contain inaccuracies.\n• You are responsible for ensuring text submitted for translation complies with applicable laws.</string>
    <string name="about_oss_title">Open Source Licenses</string>
    <string name="about_oss_summary">AndroidX Jetpack, Kotlin, OkHttp, Moshi &amp; Material Icons</string>
    <string name="about_oss_body">• AndroidX Jetpack (Compose, Material 3, Lifecycle, DataStore, Room) — Apache License 2.0\n• Kotlin &amp; Kotlinx Coroutines — Apache License 2.0\n• OkHttp &amp; Moshi — Apache License 2.0\n• Material Icons / Material Symbols — Apache License 2.0</string>
    <string name="about_feedback_title">Contact &amp; Feedback</string>
