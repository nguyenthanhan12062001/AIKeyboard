    <string name="mode_hybrid_title">Hybride Auto (IA En ligne + Secours Hors ligne)</string>
    <string name="mode_hybrid_pros">Traduction IA contextuelle en ligne ; bascule vers ML Kit hors ligne sans réseau.</string>
    <string name="mode_hybrid_cons">Envoie le texte au cloud en ligne ; nécessite ~30 Mo par pack pour le mode secours.</string>
    <string name="mode_offline_title">100% Hors ligne (Google ML Kit)</string>
    <string name="mode_offline_pros">Confidentialité maximale sur l’appareil, sans Internet, réponse instantanée.</string>
    <string name="mode_offline_cons">Téléchargement de ~30 Mo par langue requis ; phrases longues moins fluides.</string>
    <string name="mode_online_title">IA En ligne uniquement (Kilo Gateway / BYOK)</string>
    <string name="mode_online_pros">Meilleure fluidité sur les textes longs ; aucun stockage de modèle local requis.</string>
    <string name="mode_online_cons">Connexion Internet indispensable et sujette aux quotas gratuits.</string>
