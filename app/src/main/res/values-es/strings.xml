    <string name="mode_hybrid_title">Híbrido automático (IA Online + Respaldo Offline)</string>
    <string name="mode_hybrid_pros">Traducción natural con IA en línea; cambia automáticamente a ML Kit sin conexión si falla la red.</string>
    <string name="mode_hybrid_cons">Envía texto a la nube cuando hay conexión; el respaldo offline requiere paquetes de ~30 MB.</string>
    <string name="mode_offline_title">Solo sin conexión (Google ML Kit)</string>
    <string name="mode_offline_pros">Privacidad total en el dispositivo, funciona sin Internet y responde al instante.</string>
    <string name="mode_offline_cons">Requiere descargar ~30 MB por idioma; menos natural que los LLM en frases largas.</string>
    <string name="mode_online_title">Solo IA en línea (Kilo Gateway / BYOK)</string>
    <string name="mode_online_pros">Máxima fluidez en párrafos largos y modismos sin ocupar espacio local.</string>
    <string name="mode_online_cons">Requiere conexión constante a Internet y depende de los límites gratuitos.</string>
